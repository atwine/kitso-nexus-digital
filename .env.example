# Copy this file to .env and fill in the real values. Git never saves .env.
# The same names go into Netlify's site settings when the site goes live.

# Kitso's Odoo
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database-name
# An API key of type RPC, made in Odoo under Preferences > Account Security
ODOO_API_KEY=paste-the-key-here
# Login (email) of the person every new lead is assigned to in Odoo
ODOO_SALESPERSON_LOGIN=sales@kitsonexus.com

# Google Workspace email
# The real mailbox that sends. If it isn't MAIL_FROM, add MAIL_FROM to it under Gmail's "Send mail as"
GMAIL_USER=you@kitsonexus.com
# A Google app password (16 letters), made at myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# The address visitors see on their report
MAIL_FROM=info@kitsonexus.com
# Who gets lead alerts, separated by commas
ALERT_TO=info@kitsonexus.com

# Cal.com: the secret set on the booking webhook (/api/cal-booking)
CAL_WEBHOOK_SECRET=make-up-a-long-random-string

# Stamps the report links in the fit check email. A long random value; changing it stops old links working
REPORT_LINK_SECRET=make-up-a-long-random-string
